    "retail": { "match": ["retail", "store", "shop", "boutique", "showroom", "gallery"], "zone": "commercial", "parkingPer1000": { "los_angeles": 4, "houston": 4 }, "sfPerTon": [250, 350], "permit": "tenant improvement" },
