{
  "name": "hermit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "etl": "tsx pipeline/etl.ts",
    "matterport": "tsx --env-file=.env pipeline/matterport.ts",
    "sample": "tsx pipeline/sample.ts",
    "demo": "tsx scripts/record-demo.ts",
    "db:import": "tsx pipeline/import-db.ts",
    "db:push-catalog": "tsx --env-file=.env pipeline/push-catalog.ts",
    "explore": "tsx scripts/explore.ts",
    "mcp": "tsx mcp/hermit-server.ts",
    "mcp:check": "tsx mcp/smoke.ts",
    "eval:design": "tsx --env-file-if-exists=.env scripts/eval-design.ts",
    "postinstall": "matterport-assets public/mp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@matterport/webcomponent": "^0.1.47",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.184.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
